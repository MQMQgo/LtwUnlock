<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.mqmqgo.ltwunlock">

    <queries>
        <package android:name="com.microsoft.appmanager" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher_round"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/LtwTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="@string/log_title"
            android:theme="@style/LtwTheme" />

        <!-- libxposed service 102.0.0 binder delivery -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="io.github.mqmqgo.ltwunlock.XposedService"
            android:exported="true" />

        <!-- Hook log sink: call()-only, caller uid checked (system_server / LTW) -->
        <provider
            android:name=".LogProvider"
            android:authorities="io.github.mqmqgo.ltwunlock.logs"
            android:exported="true" />

        <provider
            android:name=".LtwFileProvider"
            android:authorities="io.github.mqmqgo.ltwunlock.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
